{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/quiz",
      "destination": "/quiz/index.html"
    },
    {
      "source": "/quiz/",
      "destination": "/quiz/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/planos",
      "destination": "/website-por-assinatura",
      "permanent": true
    },
    {
      "source": "/planos.html",
      "destination": "/website-por-assinatura",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.teovox.com.br"
        }
      ],
      "destination": "https://teovox.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "teovox.vercel.app"
        }
      ],
      "destination": "https://teovox.com.br/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(quiz|briefing-perictus|briefing-website)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
