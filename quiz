            ></textarea>
          </div>

          <div class="field">
            <label class="field-label">
              Nome do responsável pelo preenchimento <span class="required">*</span>
            </label>
            <input
              class="input"
              type="text"
              name="responsavel_nome"
              placeholder="Nome completo"
              required
            >
            <div class="error-message">Informe seu nome.</div>
          </div>

          <div class="two-columns">

            <div class="field">
              <label class="field-label">
                WhatsApp do responsável
              </label>
              <input
                class="input"
                type="tel"
                name="responsavel_whatsapp"
                placeholder="(00) 0 0000-0000"
              >
            </div>

            <div class="field">
              <label class="field-label">
                E-mail do responsável
              </label>
              <input
                class="input"
                type="email"
                name="responsavel_email"
                placeholder="seu@email.com"
              >
            </div>

          </div>

        </div>

        <!-- ==========================================
             REVISÃO
        =========================================== -->

        <div class="question-screen" data-step="13">

          <span class="section-marker">Revisão</span>

          <h2 class="question-title">
            Confira suas respostas.
          </h2>

          <div class="review-intro">
            <p>
              Antes de enviar, confira as informações abaixo. Se precisar
              alterar alguma coisa, utilize o botão "Voltar".
            </p>
          </div>

          <div id="review-container"></div>

        </div>

        <!-- =========================
             NAVIGATION
        ========================== -->

        <div class="quiz-navigation">

          <button
            type="button"
            class="btn btn-secondary"
            id="prev-btn"
            style="display:none;"
          >
            ← Voltar
          </button>

          <div style="flex:1;"></div>

          <button
            type="button"
            class="btn btn-primary"
            id="next-btn"
          >
            Continuar →
          </button>

          <button
            type="submit"
            class="btn btn-primary btn-submit"
            id="submit-btn"
            style="display:none;"
          >
            Enviar respostas →
          </button>

        </div>

        <div class="global-error" id="global-error"></div>

      </div>

    </form>

    <!-- =========================
         SUCCESS
    ========================== -->

    <div class="success-screen" id="success-screen">

      <div class="success-icon">
        ✓
      </div>

      <h2>
        Respostas enviadas!
      </h2>

      <p>
        Recebemos as informações da sua igreja.
        A equipe da Teovox utilizará esse material como base
        para a criação do novo site.
      </p>

    </div>

  </div>

</main>

<footer>
  <p>
    <strong>Teovox</strong> — Sua competência vista com criatividade e inteligência.
  </p>
</footer>

<script>

  /* ==========================================================
     CONFIGURAÇÕES
  ========================================================== */

  const TOTAL_STEPS = 13;

  /*
    Este é o mesmo endpoint Formspree utilizado no formulário
    do site atual da Teovox.

    Caso o briefing deva ser enviado para outro formulário/e-mail,
    altere apenas esta URL.
  */
  const FORMSPREE_ENDPOINT = "https://formspree.io/f/meewkygv";


  /* ==========================================================
     ELEMENTOS
  ========================================================== */

  const form = document.getElementById("quiz-form");
  const screens = document.querySelectorAll(".question-screen");

  const nextBtn = document.getElementById("next-btn");
  const prevBtn = document.getElementById("prev-btn");
  const submitBtn = document.getElementById("submit-btn");

  const progressBar = document.getElementById("progress-bar");
  const progressNumber = document.getElementById("progress-number");

  const reviewContainer = document.getElementById("review-container");
  const globalError = document.getElementById("global-error");

  const successScreen = document.getElementById("success-screen");
  const quizShell = document.getElementById("quiz-shell");


  /* ==========================================================
     ESTADO
  ========================================================== */

  let currentStep = 1;


  /* ==========================================================
     NAVEGAÇÃO
  ========================================================== */

  function updateScreen() {

    screens.forEach(screen => {
      screen.classList.remove("active");
    });

    const currentScreen =
      document.querySelector(
        `.question-screen[data-step="${currentStep}"]`
      );

    if (currentScreen) {
      currentScreen.classList.add("active");
    }

    const percentage =
      ((currentStep - 1) / (TOTAL_STEPS - 1)) * 100;

    progressBar.style.width = `${percentage}%`;

    progressNumber.textContent =
      currentStep <= 12
        ? `${currentStep} de 12`
        : "Revisão";

    prevBtn.style.display =
      currentStep > 1 ? "inline-flex" : "none";

    nextBtn.style.display =
      currentStep < 13 ? "inline-flex" : "none";

    submitBtn.style.display =
      currentStep === 13 ? "inline-flex" : "none";

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  }


  /* ==========================================================
     VALIDAÇÃO
  ========================================================== */

  function validateCurrentStep() {

    const screen =
      document.querySelector(
        `.question-screen[data-step="${currentStep}"]`
      );

    if (!screen) return true;

    let valid = true;

    screen
      .querySelectorAll(".field")
      .forEach(field => field.classList.remove("invalid"));

    const requiredInputs =
      screen.querySelectorAll(
        "input[required], textarea[required], select[required]"
      );

    requiredInputs.forEach(input => {

      if (!input.value.trim()) {

        const field = input.closest(".field");

        if (field) {
          field.classList.add("invalid");
        }

        valid = false;
      }
    });

    if (!valid) {

      const firstInvalid =
        screen.querySelector(".field.invalid");

      if (firstInvalid) {
        firstInvalid.scrollIntoView({
          behavior: "smooth",
          block: "center"
        });
      }
    }

    return valid;
  }


  /* ==========================================================
     PRÓXIMO
  ========================================================== */

  nextBtn.addEventListener("click", () => {

    if (!validateCurrentStep()) {
      return;
    }

    if (currentStep < 13) {
      currentStep++;
    }

    if (currentStep === 13) {
      generateReview();
    }

    updateScreen();
  });


  /* ==========================================================
     VOLTAR
  ========================================================== */

  prevBtn.addEventListener("click", () => {

    if (currentStep > 1) {
      currentStep--;
      updateScreen();
    }
  });


  /* ==========================================================
     FORMATAÇÃO DOS DADOS
  ========================================================== */

  function getFormDataObject() {

    const data = {};

    const formData = new FormData(form);

    for (const [key, value] of formData.entries()) {

      if (key.endsWith("[]")) {

        if (!data[key]) {
          data[key] = [];
        }

        data[key].push(value);

      } else {

        data[key] = value;

      }
    }

    return data;
  }


  /* ==========================================================
     LABELS AMIGÁVEIS
  ========================================================== */

  const labels = {

    igreja_nome: "Nome oficial",
    igreja_nome_conhecido: "Nome conhecido",
    igreja_denominacao: "Denominação",
    igreja_slogan: "Slogan / lema",
    igreja_historia: "História",
    igreja_descricao: "Descrição",

    identidade_missao: "Missão",
    identidade_visao: "Visão",
    identidade_valores: "Valores",
    posicionamento: "Posicionamento",
    identidade_nao_representa: "O que não representa a igreja",

    lideranca_pastor: "Pastor / líder principal",
    lideranca_cargo: "Cargo",
    lideranca_biografia: "Biografia",
    lideranca_outros: "Outros líderes",

    contato_endereco: "Endereço",
    contato_telefone: "Telefone",
    contato_whatsapp: "WhatsApp",
    contato_email: "E-mail",
    contato_como_chegar: "Como chegar",
    acessibilidade: "Acessibilidade",

    programacao_cultos: "Cultos",
    programacao_eventos: "Eventos",
    programacao_anuais: "Eventos anuais",
    programacao_frequencia: "Frequência de atualização",

    ministerios: "Ministérios",
    ministerios_destaque: "Ministério em destaque",
    pequenos_grupos: "Pequenos grupos / células",
    pequenos_grupos_detalhes: "Detalhes dos pequenos grupos",

    doutrina_declaracao: "Declaração de fé",
    doutrina_principais: "Principais crenças",
    doutrina_evitar: "Cuidados doutrinários",
    doutrina_versiculo: "Versículo",

    publico: "Públicos",
    publico_regiao: "Região atendida",
    publico_duvidas: "Dúvidas dos visitantes",
    publico_primeira_visita: "Primeira visita",

    social_instagram: "Instagram",
    social_facebook: "Facebook",
    social_youtube: "YouTube",
    social_outros: "Outras redes",
    transmissao: "Transmissão",
    transmissao_link: "Link da transmissão",
    materiais: "Materiais disponíveis",

    funcionalidades: "Funcionalidades",
    funcionalidades_detalhes: "Detalhes das funcionalidades",

    referencias_igrejas: "Referências de igrejas",
    referencias_outros: "Outras referências",
    referencias_evitar: "Estilos a evitar",
    elementos_obrigatorios: "Elementos obrigatórios",
    elementos_proibidos: "Elementos proibidos",

    prioridades_3_informacoes: "3 informações principais",
    prioridade_acao: "Ação principal",
    sucesso_projeto: "Critério de sucesso",
    informacoes_adicionais: "Informações adicionais",

    responsavel_nome: "Responsável",
    responsavel_whatsapp: "WhatsApp do responsável",
    responsavel_email: "E-mail do responsável"
  };


  /* ==========================================================
     SEÇÕES DA REVISÃO
  ========================================================== */

  const reviewSections = [

    {
      title: "Sobre a igreja",
      keys: [
        "igreja_nome",
        "igreja_nome_conhecido",
        "igreja_denominacao",
        "igreja_slogan",
        "igreja_historia",
        "igreja_descricao"
      ]
    },

    {
      title: "Missão e identidade",
      keys: [
        "identidade_missao",
        "identidade_visao",
        "identidade_valores",
        "posicionamento",
        "identidade_nao_representa"
      ]
    },

    {
      title: "Liderança",
      keys: [
        "lideranca_pastor",
        "lideranca_cargo",
        "lideranca_biografia",
        "lideranca_outros"
      ]
    },

    {
      title: "Localização e contato",
      keys: [
        "contato_endereco",
        "contato_telefone",
        "contato_whatsapp",
        "contato_email",
        "contato_como_chegar",
        "acessibilidade"
      ]
    },

    {
      title: "Cultos e programação",
      keys: [
        "programacao_cultos",
        "programacao_eventos",
        "programacao_anuais",
        "programacao_frequencia"
      ]
    },

    {
      title: "Ministérios",
      keys: [
        "ministerios",
        "ministerios_destaque",
        "pequenos_grupos",
        "pequenos_grupos_detalhes"
      ]
    },

    {
      title: "Fé e doutrina",
      keys: [
        "doutrina_declaracao",
        "doutrina_principais",
        "doutrina_evitar",
        "doutrina_versiculo"
      ]
    },

    {
      title: "Público e visitantes",
      keys: [
        "publico",
        "publico_regiao",
        "publico_duvidas",
        "publico_primeira_visita"
      ]
    },

    {
      title: "Conteúdo e presença digital",
      keys: [
        "social_instagram",
        "social_facebook",
        "social_youtube",
        "social_outros",
        "transmissao",
        "transmissao_link",
        "materiais"
      ]
    },

    {
      title: "Funcionalidades",
      keys: [
        "funcionalidades",
        "funcionalidades_detalhes"
      ]
    },

    {
      title: "Referências e preferências",
      keys: [
        "referencias_igrejas",
        "referencias_outros",
        "referencias_evitar",
        "elementos_obrigatorios",
        "elementos_proibidos"
      ]
    },

    {
      title: "Informações finais",
      keys: [
        "prioridades_3_informacoes",
        "prioridade_acao",
        "sucesso_projeto",
        "informacoes_adicionais",
        "responsavel_nome",
        "responsavel_whatsapp",
        "responsavel_email"
      ]
    }

  ];


  /* ==========================================================
     GERA REVISÃO
  ========================================================== */

  function generateReview() {

    const data = getFormDataObject();

    reviewContainer.innerHTML = "";

    reviewSections.forEach(section => {

      const sectionElement =
        document.createElement("div");

      sectionElement.className =
        "review-section";

      const title =
        document.createElement("div");

      title.className =
        "review-section-title";

      title.textContent =
        section.title;

      sectionElement.appendChild(title);

      section.keys.forEach(key => {

        let value = data[key];

        if (Array.isArray(value)) {
          value = value.join(", ");
        }

        if (!value || !String(value).trim()) {
          return;
        }

        const row =
          document.createElement("div");

        row.className =
          "review-row";

        const keyElement =
          document.createElement("div");

        keyElement.className =
          "review-key";

        keyElement.textContent =
          labels[key] || key;

        const valueElement =
          document.createElement("div");

        valueElement.className =
          "review-value";

        valueElement.textContent =
          value;

        row.appendChild(keyElement);
        row.appendChild(valueElement);

        sectionElement.appendChild(row);

      });

      reviewContainer.appendChild(sectionElement);

    });
  }


  /* ==========================================================
     SERIALIZAÇÃO ORGANIZADA PARA O FORMSPREE
  ========================================================== */

  function buildBriefingText() {

    const data = getFormDataObject();

    let output = "";

    output += "BRIEFING — NOVO SITE INSTITUCIONAL\n";
    output += "====================================\n\n";

    output += "Este briefing foi preenchido através do Quiz Teovox.\n";
    output += "Data do envio: " + new Date().toLocaleString("pt-BR") + "\n\n";

    reviewSections.forEach(section => {

      output += "\n------------------------------------\n";
      output += section.title.toUpperCase() + "\n";
      output += "------------------------------------\n\n";

      section.keys.forEach(key => {

        let value = data[key];

        if (Array.isArray(value)) {
          value = value.join(", ");
        }

        if (!value || !String(value).trim()) {
          value = "Não informado";
        }

        output += `${labels[key] || key}:\n`;
        output += `${value}\n\n`;

      });

    });

    return output;
  }


  /* ==========================================================
     ENVIO
  ========================================================== */

  form.addEventListener("submit", async (event) => {

    event.preventDefault();

    if (currentStep !== 13) {
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando…";

    globalError.style.display = "none";

    const data = getFormDataObject();

    /*
      Mantemos os campos individuais para facilitar o tratamento
      no Formspree e também enviamos um briefing consolidado.
    */

    const formData = new FormData();

    Object.entries(data).forEach(([key, value]) => {

      if (Array.isArray(value)) {

        value.forEach(item => {
          formData.append(key, item);
        });

      } else {

        formData.append(key, value);

      }

    });

    formData.append(
      "_subject",
      `Novo briefing de site — ${data.igreja_nome || "Igreja"}`
    );

    formData.append(
      "briefing_completo",
      buildBriefingText()
    );

    formData.append(
      "tipo_projeto",
      "Site institucional para igreja"
    );

    try {

      const response = await fetch(
        FORMSPREE_ENDPOINT,
        {
          method: "POST",
          body: formData,
          headers: {
            "Accept": "application/json"
          }
        }
      );

      if (!response.ok) {

        let message =
          "Não foi possível enviar as respostas. Tente novamente.";

        try {

          const result =
            await response.json();

          if (result.errors) {
            message =
              result.errors
                .map(error => error.message)
                .join(", ");
          }

        } catch (_) {}

        throw new Error(message);
      }

      document
        .querySelector(".progress-area")
        .style.display = "none";

      form.style.display = "none";

      successScreen.style.display = "block";

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });

    } catch (error) {

      globalError.textContent =
        "❌ " + error.message;

      globalError.style.display = "block";

      submitBtn.disabled = false;
      submitBtn.textContent =
        "Enviar respostas →";

      globalError.scrollIntoView({
        behavior: "smooth",
        block: "center"
      });

    }

  });


  /* ==========================================================
     INICIALIZAÇÃO
  ========================================================== */

  updateScreen();

</script>

</body>
</html>
